# Supabase (opcional — sin esto, src/lib/supabase.ts usa el proyecto de
# desarrollo hardcodeado; en producción real deberían configurarse).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (captcha de registro/login). Crea un sitio en
# https://dash.cloudflare.com/?to=/:account/turnstile — sin estas dos
# variables, el captcha simplemente no se muestra y el registro/login
# funcionan igual que hoy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# IA para la sugerencia de negociación (src/app/api/sugerencia-oferta) y el
# filtro de moderación de publicaciones nuevas (src/app/api/moderar-publicacion).
OPENAI_API_KEY=

# Secreto que solo conocen el servidor y la base de datos — protege el RPC
# ia_moderar_anuncio() para que nadie pueda auto-aprobar su propia
# publicación llamándolo directo. Genera un valor largo y aleatorio, ponlo
# aquí y corre en el SQL Editor de Supabase (ver el paso 6 de
# supabase/migracion_moderacion_ia.sql):
#   alter database postgres set app.ia_moderacion_secreto = 'EL_MISMO_VALOR_DE_ABAJO';
IA_MODERACION_SECRET=
